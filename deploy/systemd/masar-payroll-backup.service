[Unit]
Description=Masar Payroll PostgreSQL backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=orangepi
WorkingDirectory=/mnt/ssd/projects/payroll-manager
EnvironmentFile=-/mnt/ssd/projects/payroll-manager/.env.backup
ExecStart=/mnt/ssd/projects/payroll-manager/scripts/postgres-backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
