# Copy to .env and replace every CHANGE_ME value. Never commit .env.
APP_PORT=3033
PORT=3033
NODE_ENV=production
POSTGRES_DOCKER_NETWORK=CHANGE_ME_existing_network
DATABASE_URL=postgresql://CHANGE_ME_user:CHANGE_ME_password@CHANGE_ME_postgres_host:5432/CHANGE_ME_database
DB_SCHEMA=masar_payroll
DB_POOL_MAX=10
DB_SSL=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_at_least_12_characters
ADMIN_NAME=مسؤول النظام
ADMIN_EMAIL=
COMPANY_ID=comp-1
COMPANY_CODE=101
COMPANY_NAME_AR=المنشأة الرئيسية
COMPANY_NAME_EN=Main Company
COOKIE_SECURE=true
TRUST_PROXY=1
PUBLIC_URL=https://payroll.example.com
APP_ORIGIN=https://payroll.example.com
# Public company signup and 14-day trial
ALLOW_PUBLIC_REGISTRATION=false
TRIAL_DAYS=14
DEVELOPER_CONTACT_PHONE=+966500000000
# Resend transactional email (verify your sending domain first)
RESEND_API_KEY=
EMAIL_FROM=Masar <no-reply@example.com>
